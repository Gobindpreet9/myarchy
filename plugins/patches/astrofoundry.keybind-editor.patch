+# This installer changes files Hyprland loads at startup. Snapshot only the
+# files it owns, write replacements atomically, and restore the snapshot if a
+# reload or config validation fails. The snapshot is deliberately retained on
+# success as a user-visible rollback point.
+backup_dir=$(mktemp -d "$hypr_dir/.keybind-editor-backup.XXXXXX")
+cp -p -- "$main" "$backup_dir/hyprland.lua"
+for name in keybind-remap-hook.lua keybind-remaps.lua; do
+  if [[ -e $hypr_dir/$name ]]; then
+    cp -p -- "$hypr_dir/$name" "$backup_dir/$name"
+  else
+    : >"$backup_dir/$name.absent"
+  fi
+done
 
-if [[ ! -f $hypr_dir/keybind-remaps.lua ]]; then
-  cat >"$hypr_dir/keybind-remaps.lua" <<'EOF'
+rollback() {
+  local status=$?
+  if (( ! committed )); then
+    cp -p -- "$backup_dir/hyprland.lua" "$main"
+    for name in keybind-remap-hook.lua keybind-remaps.lua; do
+      if [[ -f $backup_dir/$name.absent ]]; then
+        rm -f -- "$hypr_dir/$name"
+      else
+        cp -p -- "$backup_dir/$name" "$hypr_dir/$name"
+      fi
+    done
+    hyprctl reload >/dev/null 2>&1 || true
+    echo "install: restored the pre-install configuration from $backup_dir" >&2
+  fi
+  exit "$status"
+}
+trap rollback EXIT
